# Copia questo file in ".env" e compila i valori. NON condividere mai il file .env.

# --- Database Supabase (se vuoti, il sito usa il file locale data/db.json) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=la-chiave-service_role-(Project-Settings > API)

# --- Email promemoria con Resend (se vuoto, le email sono disattivate) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM=Enrico & Grazia <prenotazioni@tuodominio.it>

