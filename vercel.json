{
  "cleanUrls": true,
  "functions": { "api/[...path].js": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/owner", "destination": "/owner/index.html" }
  ],
  "headers": [
    { "source": "/assets/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] },
    { "source": "/assets/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] }
  ],
  "crons": [{ "path": "/api/cron/reminders", "schedule": "0 9 * * *" }]
}